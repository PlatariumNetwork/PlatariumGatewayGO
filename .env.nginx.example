# Host-specific nginx proxy settings for PlatariumGatewayGO (public repo).
# Copy to .env.nginx on the server (gitignored) and adjust.
#
#   cp .env.nginx.example .env.nginx
#   # edit .env.nginx
#   bash scripts/build.sh
#
# Loaded automatically by scripts/ensure-nginx.sh (does not override already-set env).

# Public hostname of this RPC vhost (required on Hestia if cwd is not .../web/<domain>/public_html)
# NGINX_DOMAIN=rpc.example.com

# Optional fallback when domain cannot be inferred from cwd
# NGINX_DOMAIN_DEFAULT=

# Hestia panel user that owns the web domain
NGINX_HESTIA_USER=admin

# Upstream ports (must match gateway --port / --ws)
NGINX_REST_PORT=1812
NGINX_WS_PORT=1813

# Leave empty to use * (same as Go default). If set, nginx hides upstream CORS
# and sends only this single Access-Control-Allow-Origin (avoids "*, https://...").
NGINX_CORS_ORIGIN=https://web.example.com

# Hestia template basename installed under /usr/local/hestia/data/templates/web/nginx/
NGINX_TPL_NAME=platarium-gateway

# NGINX_SKIP=1
# NGINX_RELOAD=0
# NGINX_DISCOVER=1
